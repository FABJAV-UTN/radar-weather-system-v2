# Frontend: Desarrollo con hot reload
FROM node:20-alpine

WORKDIR /app

# Instalar dependencias primero (cache de Docker)
COPY package.json package-lock.json* ./
RUN npm install

# El código se monta vía volumen para hot reload
# No copiamos nada aquí

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]